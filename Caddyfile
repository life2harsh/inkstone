{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	handle /healthz {
		respond "not found" 404
	}

	handle /api/* {
		reverse_proxy server:8080
	}

	handle /health {
		respond "not found" 404
	}

	handle /pkg/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		@mutable path / /index.html /styles.css
		header @mutable Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}

http://127.0.0.1 {
	handle /healthz {
		rewrite * /health
		reverse_proxy server:8080
	}
}
