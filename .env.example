POSTGRES_USER=inkstone
POSTGRES_PASSWORD=local-development-password-change-me
POSTGRES_DB=inkstone
DATABASE_URL=postgres://inkstone:local-development-password-change-me@postgres:5432/inkstone

SITE_ADDRESS=http://localhost
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443
ALLOWED_ORIGINS=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

DEV_AUTH=false
COOKIE_SECURE=false
SESSION_TTL_HOURS=720
LOG_LEVEL=info

# Required whenever DEV_AUTH=false. Used for owner setup, invitations,
# email verification, and account-password reset mail. Configure EITHER the
# Resend HTTP API or an SMTP relay (SMTP_HOST + SMTP_FROM_EMAIL). SMTP_PORT
# defaults to 587 (STARTTLS); port 465 uses implicit TLS.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Inkstone <no-reply@localhost>"

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
