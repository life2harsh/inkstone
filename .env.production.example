POSTGRES_USER=inkstone
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=inkstone
DATABASE_URL=postgres://inkstone:CHANGE_ME_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/inkstone

SITE_ADDRESS=inkstone.example.com
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
ALLOWED_ORIGINS=https://inkstone.example.com
PUBLIC_BASE_URL=https://inkstone.example.com

DEV_AUTH=false
COOKIE_SECURE=true
SESSION_TTL_HOURS=720
LOG_LEVEL=info

# Required for owner setup, invitations, email verification, and password reset.
# Configure EITHER the Resend HTTP API or an SMTP relay (SMTP_HOST + SMTP_FROM_EMAIL).
RESEND_API_KEY=
RESEND_FROM_EMAIL="Inkstone <no-reply@inkstone.example.com>"

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Set to true to run without email. Invitation links are then shown to the
# inviter to share by hand, and password-reset email is unavailable.
EMAIL_OPTIONAL=false
